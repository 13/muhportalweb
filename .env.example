# MQTT Broker Configuration (used by backend server)
MQTT_BROKER_URL=mqtt://192.168.22.5:1883

# CORS Configuration for Socket.IO (comma-separated list of allowed origins)
# Use '*' for all origins (not recommended in production) or specific URLs
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
CORS_ORIGINS=

# Allow browser clients to reconfigure the server's MQTT broker connection
# via the config page. Affects all connected clients - leave disabled unless
# the app is only reachable from a trusted network.
ALLOW_MQTT_RECONFIGURE=false

# Shared token required on the Socket.IO handshake. Clients enter it on the
# config page ("Auth Token"). Empty = authentication disabled.
AUTH_TOKEN=

# Nuxt Configuration
NUXT_HOST=0.0.0.0
NUXT_PORT=3000

# Docker Compose Configuration (optional)
# PUID=1000
# PGID=1000
# DOMAIN=example.com
